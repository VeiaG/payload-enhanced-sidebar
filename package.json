{
  "name": "@veiag/payload-enhanced-sidebar",
  "version": "1.0.0-beta.1",
  "description": "An enhanced sidebar plugin for Payload CMS with tabbed navigation to organize collections and globals.",
  "author": "VeiaG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeiaG/payload-enhanced-sidebar.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/exports/client.ts",
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    },
    "./rsc": {
      "import": "./src/exports/rsc.ts",
      "types": "./src/exports/rsc.ts",
      "default": "./src/exports/rsc.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "check:exports": "node ./scripts/check-exports.mjs",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:tanstack": "pnpm --filter dev-tanstack dev",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "4.0.0-beta.0",
    "@payloadcms/db-postgres": "4.0.0-beta.0",
    "@payloadcms/db-sqlite": "4.0.0-beta.0",
    "@payloadcms/eslint-config": "3.9.0",
    "@payloadcms/next": "4.0.0-beta.0",
    "@payloadcms/plugin-multi-tenant": "4.0.0-beta.0",
    "@payloadcms/richtext-lexical": "4.0.0-beta.0",
    "@payloadcms/transformer-sharp": "4.0.0-beta.0",
    "@payloadcms/ui": "4.0.0-beta.0",
    "@playwright/test": "1.56.1",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.4.0",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.4.0",
    "open": "^10.1.0",
    "payload": "4.0.0-beta.0",
    "prettier": "^3.4.2",
    "qs-esm": "7.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "3.0.2",
    "sort-package-json": "^2.10.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "payload": "^4.0.0-beta.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./rsc": {
        "import": "./dist/exports/rsc.js",
        "types": "./dist/exports/rsc.d.ts",
        "default": "./dist/exports/rsc.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "registry": "https://registry.npmjs.org/",
  "dependencies": {
    "@payloadcms/translations": "4.0.0-beta.0",
    "lucide-react": "^0.556.0"
  }
}
