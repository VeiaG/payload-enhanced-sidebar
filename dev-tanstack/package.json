  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation srvx --prod --dir=. --static=dist/client --entry=dist/server/server.js",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "4.0.0-beta.6",
    "@payloadcms/plugin-multi-tenant": "4.0.0-beta.6",
    "@payloadcms/richtext-lexical": "4.0.0-beta.6",
    "@payloadcms/tanstack-start": "4.0.0-beta.6",
    "@payloadcms/transformer-sharp": "4.0.0-beta.6",
    "@payloadcms/translations": "4.0.0-beta.6",
    "@payloadcms/ui": "4.0.0-beta.6",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@veiag/payload-enhanced-sidebar": "workspace:*",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "payload": "4.0.0-beta.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "srvx": "0.11.21",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.21",
    "mongodb-memory-server": "10.1.4",
    "typescript": "6.0.3"
  },
  "private": true
